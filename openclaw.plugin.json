{
  "id": "clawgram",
  "name": "Clawgram",
  "description": "Clawgram — personal Telegram (MTProto userbot) channel for OpenClaw. Your AI assistant reads and responds as you.",
  "version": "2.13.1",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channels": [
    "clawgram"
  ],
  "channelConfigs": {
    "clawgram": {
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "allowFrom": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ]
            }
          },
          "groups": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "groupPolicy": {
                  "type": "string",
                  "enum": [
                    "open",
                    "mention"
                  ],
                  "default": "mention"
                },
                "allowFrom": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  }
                }
              }
            }
          },
          "accounts": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "apiId": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*$"
                    }
                  ]
                },
                "apiHash": {
                  "description": "Literal value, or a SecretRef resolved at account start-up.",
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "required": [
                        "source",
                        "provider",
                        "id"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "source": {
                          "enum": [
                            "env",
                            "file",
                            "exec"
                          ]
                        },
                        "provider": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                        },
                        "id": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ]
                },
                "sessionString": {
                  "description": "Literal value, or a SecretRef resolved at account start-up.",
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "required": [
                        "source",
                        "provider",
                        "id"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "source": {
                          "enum": [
                            "env",
                            "file",
                            "exec"
                          ]
                        },
                        "provider": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                        },
                        "id": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ]
                },
                "proxy": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "ip": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "port": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    "socksType": {
                      "type": "integer",
                      "enum": [
                        4,
                        5
                      ]
                    },
                    "username": {
                      "description": "Literal value, or a SecretRef resolved at account start-up.",
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "required": [
                            "source",
                            "provider",
                            "id"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "source": {
                              "enum": [
                                "env",
                                "file",
                                "exec"
                              ]
                            },
                            "provider": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                            },
                            "id": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        }
                      ]
                    },
                    "password": {
                      "description": "Literal value, or a SecretRef resolved at account start-up.",
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "required": [
                            "source",
                            "provider",
                            "id"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "source": {
                              "enum": [
                                "env",
                                "file",
                                "exec"
                              ]
                            },
                            "provider": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                            },
                            "id": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        }
                      ]
                    },
                    "timeout": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "ip",
                    "port",
                    "socksType"
                  ]
                },
                "allowFrom": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  }
                },
                "groups": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "enabled": {
                        "type": "boolean"
                      },
                      "groupPolicy": {
                        "type": "string",
                        "enum": [
                          "open",
                          "mention"
                        ],
                        "default": "mention"
                      },
                      "allowFrom": {
                        "type": "array",
                        "items": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "number"
                            }
                          ]
                        }
                      }
                    }
                  }
                },
                "readChats": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Chat ids the account may read history and membership for. Absent means no restriction; an empty array denies everything."
                },
                "manageChats": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Chat ids the account may MANAGE (2.12.0): add/remove members, promote/demote admins, transfer ownership, export invite links; a non-empty list also unlocks createGroup. Opposite default to readChats: absent or empty means chat management is off, [\"*\"] allows every chat."
                },
                "twoFaPassword": {
                  "description": "The account's Telegram 2FA (cloud) password — needed only by transferOwnership, which Telegram guards with an SRP proof. Literal value, or a SecretRef resolved at account start-up.",
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "required": [
                        "source",
                        "provider",
                        "id"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "source": {
                          "enum": [
                            "env",
                            "file",
                            "exec"
                          ]
                        },
                        "provider": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                        },
                        "id": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ]
                },
                "joinsJournalPath": {
                  "type": "string",
                  "description": "Where joins observed for this account are journalled. Defaults to a per-account file under the OpenClaw state directory."
                },
                "reactionLevel": {
                  "type": "string",
                  "enum": [
                    "off",
                    "ack",
                    "minimal",
                    "extensive"
                  ],
                  "description": "How freely the agent may leave emoji reactions (2.8.0). Core injects its `## Reactions` prompt section only for `minimal` and `extensive`; `off` and `ack` leave the prompt silent about reactions, and the agent then effectively never reacts on its own. Absent means `minimal`. Mirrors the bundled Telegram channel's reactionLevel."
                },
                "replyParseMode": {
                  "type": "string",
                  "enum": [
                    "markdown",
                    "md",
                    "html"
                  ],
                  "description": "Parse mode for replies (2.3.1). The send action takes parseMode per call; the reply pipeline has no per-call slot, so the reply format is configured here. Absent means plain text."
                }
              },
              "required": [
                "apiId",
                "apiHash",
                "sessionString"
              ]
            }
          }
        }
      },
      "uiHints": {
        "accounts.*.manageChats": {
          "label": "Managed Chats",
          "help": "Chat ids the assistant may manage (create groups, add/remove members, admins, ownership, invite links). Leave empty to keep chat management off; use * to allow every chat.",
          "advanced": true
        },
        "accounts.*.twoFaPassword": {
          "label": "2FA Password",
          "help": "The account's Telegram two-step verification password. Only needed for ownership transfer.",
          "sensitive": true,
          "advanced": true
        },
        "accounts.*.proxy": {
          "label": "SOCKS Proxy",
          "help": "Optional native SOCKS4/SOCKS5 proxy for this account's MTProto connection. GramJS uses raw TCP sockets, so OpenClaw's proxy.proxyUrl does not cover it. This is a SOCKS proxy, not a Telegram MTProxy.",
          "advanced": true
        },
        "accounts.*.proxy.ip": {
          "label": "Proxy Host",
          "help": "Proxy hostname or IP address.",
          "placeholder": "proxy.example.com"
        },
        "accounts.*.proxy.port": {
          "label": "Proxy Port",
          "help": "Proxy TCP port (1-65535).",
          "placeholder": "1080"
        },
        "accounts.*.proxy.socksType": {
          "label": "SOCKS Version",
          "help": "5 for SOCKS5, 4 for SOCKS4.",
          "placeholder": "5"
        },
        "accounts.*.proxy.username": {
          "label": "Proxy Username",
          "help": "Optional username for proxies that require authentication."
        },
        "accounts.*.proxy.password": {
          "label": "Proxy Password",
          "help": "Optional password for proxies that require authentication.",
          "sensitive": true
        },
        "accounts.*.proxy.timeout": {
          "label": "Proxy Timeout",
          "help": "Optional proxy connection timeout in seconds (GramJS default: 5).",
          "placeholder": "10"
        }
      }
    }
  }
}
