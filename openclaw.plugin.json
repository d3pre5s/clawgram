{
  "id": "clawgram",
  "name": "Clawgram",
  "description": "Clawgram — personal Telegram (MTProto userbot) channel for OpenClaw. Your AI assistant reads and responds as you.",
  "version": "2.1.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channels": [
    "clawgram"
  ],
  "channelConfigs": {
    "clawgram": {
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "allowFrom": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ]
            }
          },
          "groups": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "groupPolicy": {
                  "type": "string",
                  "enum": [
                    "open",
                    "mention"
                  ],
                  "default": "mention"
                },
                "allowFrom": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  }
                }
              }
            }
          },
          "accounts": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "apiId": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*$"
                    }
                  ]
                },
                "apiHash": {
                  "type": "string"
                },
                "sessionString": {
                  "type": "string"
                },
                "proxy": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "ip": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "port": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    "socksType": {
                      "type": "integer",
                      "enum": [
                        4,
                        5
                      ]
                    },
                    "username": {
                      "type": "string"
                    },
                    "password": {
                      "type": "string"
                    },
                    "timeout": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "ip",
                    "port",
                    "socksType"
                  ]
                },
                "allowFrom": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  }
                },
                "groups": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "enabled": {
                        "type": "boolean"
                      },
                      "groupPolicy": {
                        "type": "string",
                        "enum": [
                          "open",
                          "mention"
                        ],
                        "default": "mention"
                      },
                      "allowFrom": {
                        "type": "array",
                        "items": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "number"
                            }
                          ]
                        }
                      }
                    }
                  }
                },
                "readChats": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Chat ids the account may read history and membership for. Absent means no restriction; an empty array denies everything."
                },
                "joinsJournalPath": {
                  "type": "string",
                  "description": "Where joins observed for this account are journalled. Defaults to a per-account file under the OpenClaw state directory."
                }
              },
              "required": [
                "apiId",
                "apiHash",
                "sessionString"
              ]
            }
          }
        }
      },
      "uiHints": {
        "accounts.*.proxy": {
          "label": "SOCKS Proxy",
          "help": "Optional native SOCKS4/SOCKS5 proxy for this account's MTProto connection. GramJS uses raw TCP sockets, so OpenClaw's proxy.proxyUrl does not cover it. This is a SOCKS proxy, not a Telegram MTProxy.",
          "advanced": true
        },
        "accounts.*.proxy.ip": {
          "label": "Proxy Host",
          "help": "Proxy hostname or IP address.",
          "placeholder": "proxy.example.com"
        },
        "accounts.*.proxy.port": {
          "label": "Proxy Port",
          "help": "Proxy TCP port (1-65535).",
          "placeholder": "1080"
        },
        "accounts.*.proxy.socksType": {
          "label": "SOCKS Version",
          "help": "5 for SOCKS5, 4 for SOCKS4.",
          "placeholder": "5"
        },
        "accounts.*.proxy.username": {
          "label": "Proxy Username",
          "help": "Optional username for proxies that require authentication."
        },
        "accounts.*.proxy.password": {
          "label": "Proxy Password",
          "help": "Optional password for proxies that require authentication.",
          "sensitive": true
        },
        "accounts.*.proxy.timeout": {
          "label": "Proxy Timeout",
          "help": "Optional proxy connection timeout in seconds (GramJS default: 5).",
          "placeholder": "10"
        }
      }
    }
  }
}
